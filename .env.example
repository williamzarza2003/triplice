# Copiá este archivo a .env.local (no se sube al repo). Sin estas variables, la web usa la base embebida (PGlite)
# y el pago pasa por el simulador de prueba. Ver docs/supabase.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (nunca con NEXT_PUBLIC_): registra y confirma los pedidos en Supabase
SUPABASE_SERVICE_ROLE_KEY=
# URL pública del sitio (para las imágenes de redes, el sitemap y la vuelta de Stripe)
NEXT_PUBLIC_SITIO=http://localhost:3000

# Stripe SOLO en modo de prueba: una clave sk_live_ se rechaza
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Firma de los comprobantes del comprador (32 caracteres o más; obligatoria en producción)
TRIPLICE_SECRETO=
