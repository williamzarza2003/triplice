# Copiá este archivo a .env.local (no se sube al repo). Sin estas variables, la web usa la base embebida (PGlite)
# y el pago pasa por el simulador de prueba. Ver docs/supabase.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (nunca con NEXT_PUBLIC_): registra y confirma los pedidos en Supabase
SUPABASE_SERVICE_ROLE_KEY=
# URL pública del sitio (imágenes para redes, robots.txt y la vuelta de Stripe)
NEXT_PUBLIC_SITIO=http://localhost:3000
# En Vercel: https://triplice-beta.vercel.app (si falta, se usa ese mismo)

# Stripe SOLO en modo de prueba: una clave sk_live_ se rechaza
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Firma de los comprobantes del comprador (32 caracteres o más; obligatoria en producción)
TRIPLICE_SECRETO=

# Fase 5 (admin): "Traer de Cambio CDE". Las dos son del proyecto de Supabase de Cambio CDE (Project URL y la clave
# anon public: la vista cotizaciones_actuales es pública). Solo las lee el servidor; sin ellas, el botón explica qué
# falta y la cotización se carga a mano. Ver docs/supabase.md §6.
CAMBIO_CDE_SUPABASE_URL=
CAMBIO_CDE_ANON_KEY=
